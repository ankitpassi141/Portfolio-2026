{
  "name": "SkipStone",
  "short_name": "SkipStone",
  "description": "A first-person stone-skipping game on a still lake. Tilt, pull back, let go.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "portrait",
